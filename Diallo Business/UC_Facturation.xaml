<UserControl x:Class="Diallo_Business.UC_Facturation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="#0B1120" Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- GAUCHE : LISTE DES FACTURES -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBox x:Name="TxtSearch" Width="250" TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center"/>
                <Button Content="＋ Nouvelle Facture" Click="BtnShowAdd_Click" Margin="15,0,0,0" Background="#38BDF8" Foreground="#0B1120"/>
            </StackPanel>

            <DataGrid x:Name="GridFactures" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                      SelectionChanged="GridFactures_SelectionChanged" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N°" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="95"/>
                    <DataGridTextColumn Header="CLIENT" Binding="{Binding NomClient}" Width="*"/>
                    <DataGridTextColumn Header="LIGNES" Binding="{Binding Elements.Count}" Width="70"/>
                    <DataGridTextColumn Header="TOTAL" Binding="{Binding MontantTotal, StringFormat={}{0:N0} F}" Width="100"/>
                    <DataGridTextColumn Header="PAYÉ" Binding="{Binding Accompte, StringFormat={}{0:N0} F}" Width="100"/>
                    <DataGridTemplateColumn Header="RELIQUAT" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Reliquat, StringFormat={}{0:N0} F}"
                                           Foreground="{Binding HasDebtColor}" FontWeight="Bold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" Background="#151C2C" CornerRadius="10" Margin="0,10,0,0" Padding="12">
                <UniformGrid Columns="3">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#38BDF8" Margin="0,0,8,0"/>
                        <TextBlock Text="Facturé : " Foreground="#94A3B8" FontSize="13"/>
                        <TextBlock x:Name="TxtTotalFacture" Text="0 F" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#4ADE80" Margin="0,0,8,0"/>
                        <TextBlock Text="Encaissé : " Foreground="#94A3B8" FontSize="13"/>
                        <TextBlock x:Name="TxtTotalPaye" Text="0 F" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#F87171" Margin="0,0,8,0"/>
                        <TextBlock Text="Reliquats : " Foreground="#94A3B8" FontSize="13"/>
                        <TextBlock x:Name="TxtTotalReliquat" Text="0 F" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </UniformGrid>
            </Border>
        </Grid>

                <!-- DROITE : DÉTAIL OU NOUVELLE FACTURE -->
        <Border Grid.Column="1" Background="#151C2C" CornerRadius="15" Padding="20">
            <Grid>
                <!-- MODE 1 : DÉTAIL D'UNE FACTURE -->
                <StackPanel x:Name="PanelDetail" Visibility="Collapsed">
                    <TextBlock Text="DÉTAIL FACTURE" Foreground="#38BDF8" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock x:Name="DetClient" Text="..." Foreground="White" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="DetTel" Text="..." Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock x:Name="DetDate" Text="..." Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="DgDetailLignes" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" MinHeight="120" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DÉSIGNATION" Binding="{Binding Designation}" Width="*"/>
                            <DataGridTextColumn Header="P.U" Binding="{Binding PrixUnitaire, StringFormat={}{0:N0}}" Width="65"/>
                            <DataGridTextColumn Header="QTÉ" Binding="{Binding Quantite}" Width="45"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalLigne, StringFormat={}{0:N0} F}" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Margin="0,12,0,0">
                        <Grid Margin="0,2">
                            <TextBlock Text="Montant Total" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock x:Name="DetTotal" Text="0 F" HorizontalAlignment="Right" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Déjà Payé" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock x:Name="DetPaye" Text="0 F" HorizontalAlignment="Right" Foreground="#4ADE80" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <Separator Background="#1E293B" Margin="0,6"/>
                        <Grid Margin="0,2">
                            <TextBlock Text="RESTE" Foreground="#F87171" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="DetReliquat" Text="0 F" HorizontalAlignment="Right" Foreground="#F87171" FontSize="14" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>

                    <Button x:Name="BtnSolder" Content="SOLDER LA FACTURE" Height="36" Margin="0,15,0,8"
                            Background="#059669" Foreground="White" FontSize="11" FontWeight="Bold" Click="BtnSolder_Click"/>
                    <UniformGrid Columns="2" Height="38" Margin="0,0,0,8">
                        <Button Content="🖨 Aperçu / Imprimer" Click="BtnPrint_Click" Background="#475569" Margin="0,0,4,0" FontSize="11"/>
                        <Button Content="SUPPRIMER" Click="BtnDelete_Click" Background="Transparent"
                                BorderBrush="#991B1B" BorderThickness="1" Foreground="#F87171" FontSize="11" FontWeight="Bold" Margin="4,0,0,0"/>
                    </UniformGrid>
                    <Button Content="← Retour à la saisie" Click="BtnShowAdd_Click" Height="34"
                            Background="Transparent" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/>
                </StackPanel>

                <!-- MODE 2 : NOUVELLE FACTURE (multi-lignes) -->
                <ScrollViewer x:Name="PanelForm" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="NOUVELLE FACTURE" Foreground="#38BDF8" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Nom du client"/>
                        <TextBox x:Name="InpClient" Margin="0,5,0,10"/>
                        <TextBlock Text="Téléphone (optionnel)"/>
                        <TextBox x:Name="InpTel" Margin="0,5,0,15"/>

                        <TextBlock Text="LIGNES DE LA FACTURE" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Désignation" Margin="0,8,0,0"/>
                        <TextBox x:Name="InpDesignation" Margin="0,5,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="Prix Unitaire"/>
                                <TextBox x:Name="InpPU" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Qté"/>
                                <TextBox x:Name="InpQte" Text="1" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="＋ Ajouter la ligne" Click="BtnAddLigne_Click" Height="36" Margin="0,12,0,10"
                                Background="#6366F1" Foreground="White" FontWeight="Bold"/>

                        <DataGrid x:Name="DgLignes" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" MinHeight="100" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DÉSIGNATION" Binding="{Binding Designation}" Width="*"/>
                                <DataGridTextColumn Header="QTÉ" Binding="{Binding Quantite}" Width="45"/>
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalLigne, StringFormat={}{0:N0} F}" Width="85"/>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑" Click="BtnDelLigne_Click" Background="Transparent"
                                                    BorderThickness="0" Foreground="#F87171"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="TOTAL" Foreground="White" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtFormTotal" Text="0 F" HorizontalAlignment="Right" Foreground="#38BDF8" FontSize="15" FontWeight="Bold"/>
                        </Grid>
                        <TextBlock Text="Acompte versé" Margin="0,12,0,0"/>
                        <TextBox x:Name="InpAcompte" Text="0" Margin="0,5,0,0" TextChanged="InpAcompte_TextChanged"/>
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="RELIQUAT" Foreground="#F87171" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtFormReliquat" Text="0 F" HorizontalAlignment="Right" Foreground="#F87171" FontWeight="Bold"/>
                        </Grid>

                        <UniformGrid Columns="2" Height="45" Margin="0,15,0,0">
                            <Button Content="Annuler" Click="BtnCancelForm_Click" Background="#475569" Margin="0,0,5,0"/>
                            <Button Content="Enregistrer" Click="BtnSaveFacture_Click" Background="#38BDF8" Foreground="#0B1120" Margin="5,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>