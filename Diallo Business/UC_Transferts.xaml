<UserControl x:Class="Diallo_Business.UC_Transferts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="#0B1120" Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.8*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="MOUVEMENTS DE CAISSE (HORS TRANSFERTS)" Foreground="#38BDF8" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <Border Grid.Row="1" Background="#151C2C" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="TYPE" Foreground="#94A3B8" FontSize="10" Margin="2,0,0,3"/>
                        <ComboBox x:Name="ComboTypeNote" Width="120" Height="30">
                            <ComboBoxItem Content="SORTIE" IsSelected="True"/>
                            <ComboBoxItem Content="ENTREE"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="MONTANT" Foreground="#94A3B8" FontSize="10" Margin="2,0,0,3"/>
                        <TextBox x:Name="TxtNoteMontant" Width="100" Height="30" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="DESCRIPTION" Foreground="#94A3B8" FontSize="10" Margin="2,0,0,3"/>
                        <TextBox x:Name="TxtNoteLibelle" Width="250" Height="30" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <Button Content="ENREGISTRER" Click="BtnAddNote_Click" Width="120" Height="30" Background="#6366F1" Foreground="White" FontWeight="Bold" Margin="0,13,0,0"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="GridNotes" Grid.Row="2" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="HEURE" Binding="{Binding Date, StringFormat=HH:mm}" Width="60"/>
                    <DataGridTemplateColumn Header="TYPE" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Type}" Foreground="{Binding ColorType}" FontWeight="Bold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="MONTANT" Binding="{Binding Montant, StringFormat={}{0:N0} F}" Width="100"/>
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                    <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑️" Click="BtnDeleteNote_Click" Background="Transparent" BorderThickness="0" Foreground="Red"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- FLUX DIVERS : consultation des entrées/sorties enregistrées depuis le Dashboard -->
            <TextBlock Grid.Row="3" Text="FLUX DIVERS (AUTRES ENTRÉES / SORTIES)" Foreground="#A855F7" FontSize="14" FontWeight="Bold" Margin="0,18,0,10"/>
            <DataGrid x:Name="GridFlux" Grid.Row="4" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=dd/MM HH:mm}" Width="110"/>
                    <DataGridTemplateColumn Header="TYPE" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Type}" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#F87171"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="ENTREE">
                                                    <Setter Property="Foreground" Value="#4ADE80"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="MONTANT" Binding="{Binding Montant, StringFormat={}{0:N0} F}" Width="110"/>
                    <DataGridTextColumn Header="MOTIF" Binding="{Binding Motif}" Width="*"/>
                    <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑️" Click="BtnDeleteFlux_Click" Background="Transparent" BorderThickness="0" Foreground="Red"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="1" Background="#151C2C" CornerRadius="15" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="BILAN DU SOIR" Foreground="#4ADE80" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtSoldeHier" Text="Solde matin : 0 F" Foreground="#94A3B8" FontSize="12" Margin="0,5,0,15"/>
                    <Separator Background="#1E293B" Margin="0,0,0,15"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Saisir les montants finaux :" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,10" FontStyle="Italic"/>
                        <StackPanel x:Name="ContainerSoldes"/>
                        <Button Content="+ Ajouter un nouveau service" Click="BtnAddService_Click" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" HorizontalAlignment="Left" Margin="0,10"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,15,0,0">
                    <Button Content="VALIDER ET FAIRE LE COMPTE" Click="BtnCalculer_Click" Height="45" Background="#059669" Foreground="White" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Border x:Name="BorderResultat" Visibility="Collapsed" Margin="0,15,0,0" Padding="15" CornerRadius="10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtResultatEcart" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtMsgEcart" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>