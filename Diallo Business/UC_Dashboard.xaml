<UserControl x:Class="Diallo_Business.UC_Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <UniformGrid Columns="2" Rows="2" Grid.Row="0" Height="250">
                <Border Background="#151C2C" CornerRadius="15" Margin="5" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Ventes du Jour" Foreground="#94A3B8"/>
                        <TextBlock x:Name="TxtSales" Text="0 F" Foreground="#38BDF8" FontSize="28" FontWeight="Bold" Margin="0,10"/>
                    </StackPanel>
                </Border>
                <Border Background="#151C2C" CornerRadius="15" Margin="5" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Reliquats à encaisser" Foreground="#94A3B8"/>
                        <TextBlock x:Name="TxtDebt" Text="0 F" Foreground="#F59E0B" FontSize="28" FontWeight="Bold" Margin="0,10"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="1" Background="#0F172A" CornerRadius="15" Margin="5,15,5,5" Padding="20">
                <StackPanel>
                    <TextBlock Text="Activités Récentes" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <ListBox x:Name="LstActivity" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="13">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="5">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="#151C2C" CornerRadius="20" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Saisie Rapide" Foreground="#38BDF8" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                    <ComboBox x:Name="ComboOpType" Height="40" Margin="0,0,0,20" SelectionChanged="ComboOpType_SelectionChanged">
                        <ComboBoxItem Content="🛠 Nouveau Service" IsSelected="True"/>
                        <ComboBoxItem Content="📦 Vente Article"/>
                        <ComboBoxItem Content="🎓 Paiement Formation"/>
                        <ComboBoxItem Content="💸 Flux Divers (Entrée/Sortie)"/>
                    </ComboBox>

                    <StackPanel x:Name="PanelService">
                        <TextBlock Text="Type de Service"/>
                        <ComboBox x:Name="InpServiceNom" IsEditable="True" Margin="0,5,0,15" Height="35"/>
                        <TextBlock Text="Client / Description"/>
                        <TextBox x:Name="InpServiceClient" Text="Client" Margin="0,5,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Total à payer"/>
                                <TextBox x:Name="InpServiceTotal" Margin="0,5,0,15"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Accompte reçue"/>
                                <TextBox x:Name="InpServiceAvance" Margin="0,5,0,15"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PanelFormation" Visibility="Collapsed">
                        <TextBlock Text="Nom de l'élève"/>
                        <TextBox x:Name="InpFormNomClient" Margin="0,5,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Prix Total (F)"/>
                                <TextBox x:Name="InpFormPrixTotal" Margin="0,5,0,15"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Acompte Payé (F)"/>
                                <TextBox x:Name="InpFormAccompte" Margin="0,5,0,15"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Planification (Jours / Heures)"/>
                        <TextBox x:Name="InpFormPlanif" Margin="0,5,0,15" ToolTip="Ex: Lun-Mer 14h-16h"/>
                    </StackPanel>

                    <StackPanel x:Name="PanelArticle" Visibility="Collapsed">
                        <TextBlock Text="Sélectionner l'article"/>
                        <ComboBox x:Name="InpArtSelection" Margin="0,5,0,15" Height="35" 
                            DisplayMemberPath="Nom" SelectionChanged="InpArtSelection_SelectionChanged"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Prix Unitaire"/>
                                <TextBox x:Name="InpArtPrix"  Background="#0F172A" Margin="0,5,0,15"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Quantité à vendre"/>
                                <TextBox x:Name="InpArtQte" Text="1" Margin="0,5,0,15"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Nom du Client (Optionnel)"/>
                        <TextBox x:Name="InpArtClient" Margin="0,5,0,15"/>
                    </StackPanel>
                    
                    <StackPanel x:Name="PanelFlux" Visibility="Collapsed">
                        <TextBlock Text="Type"/>
                        <ComboBox x:Name="InpFluxType" Margin="0,5,0,15">
                            <ComboBoxItem Content="Entrée"/>
                            <ComboBoxItem Content="Sortie"/>
                        </ComboBox>
                        <TextBlock Text="Motif (Eau, Loyer, etc.)"/>
                        <TextBox x:Name="InpFluxMotif" Margin="0,5,0,15"/>
                        <TextBlock Text="Montant"/>
                        <TextBox x:Name="InpFluxMontant" Margin="0,5,0,15"/>
                    </StackPanel>

                    <Button Content="Enregistrer l'opération" Click="BtnSaveOp_Click" 
                            Background="#38BDF8" Foreground="#0B1120" Height="45" FontWeight="Bold" Margin="0,20,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>