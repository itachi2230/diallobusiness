<Window x:Class="Diallo_Business.Win_Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion - Diallo Business" Height="630" Width="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Border Background="#0B1120" CornerRadius="20" BorderBrush="#1E293B" BorderThickness="1" Margin="20">
        <Grid>
            <!-- Barre supérieure : déplacement + fermeture -->
            <Grid x:Name="BarreFenetre" Grid.Row="0" Height="40" VerticalAlignment="Top"
                  Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Button x:Name="BtnQuit" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="40" Height="30" Margin="0,0,10,0" Background="Transparent" BorderThickness="0"
                        Foreground="#94A3B8" FontSize="14" Click="BtnQuit_Click" ToolTip="Quitter l'application"/>
            </Grid>

            <StackPanel Margin="40,20,40,30" VerticalAlignment="Center">
                <Border Width="70" Height="70" Background="#38BDF8" CornerRadius="18" HorizontalAlignment="Center">
                    <TextBlock Text="D" Foreground="White" FontWeight="Bold" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="DIALLO BUSINESS" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,4"/>
                <TextBlock Text="Gestion de Business Center" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="NOM D'UTILISATEUR" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                <TextBox x:Name="InpUsername" Margin="0,6,0,14"/>

                <TextBlock Text="MOT DE PASSE" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                <PasswordBox x:Name="InpPassword" Margin="0,6,0,6" KeyDown="InpPassword_KeyDown"/>

                <TextBlock x:Name="TxtMessage" Text="" Foreground="#F87171" FontSize="12" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,4,0,8"/>

                <Button x:Name="BtnLogin" Content="SE CONNECTER" Height="45" Margin="0,8,0,0"
                        Background="#38BDF8" Foreground="#0B1120" FontWeight="Bold"
                        IsDefault="True" Click="BtnLogin_Click"/>

                <Separator Background="#1E293B" Margin="0,20,0,15"/>

                <Button x:Name="BtnCreerCompte" Content="＋ Créer un compte (agent)" Height="38"
                        Background="Transparent" BorderBrush="#38BDF8" BorderThickness="1" Foreground="#38BDF8"
                        FontWeight="Bold" Click="BtnCreerCompte_Click"/>
                <TextBlock Text="Un compte créé reste inactif jusqu'à son activation par un administrateur."
                           Foreground="#475569" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>

                <TextBlock x:Name="TxtRappelDefault" Text="Première utilisation : admin / admin123"
                           Foreground="#F59E0B" FontSize="10" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>