<UserControl x:Class="Diallo_Business.UC_Utilisateurs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="#0B1120" Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="ColFormUser" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- COLONNE GAUCHE : LISTE + STATS -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#151C2C" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="👥 GESTION DES UTILISATEURS" Foreground="#38BDF8" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Créez, activez, modifiez ou supprimez les comptes. Un compte « En attente » ne peut pas se connecter."
                               Foreground="#94A3B8" FontSize="11" Margin="0,5,0,12"/>
                    <UniformGrid Columns="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#38BDF8" Margin="0,0,8,0"/>
                            <TextBlock Text="Total : " Foreground="#94A3B8" FontSize="13"/>
                            <TextBlock x:Name="TxtStatTotal" Text="0" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#4ADE80" Margin="0,0,8,0"/>
                            <TextBlock Text="Actifs : " Foreground="#94A3B8" FontSize="13"/>
                            <TextBlock x:Name="TxtStatActifs" Text="0" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,8,0"/>
                            <TextBlock Text="En attente : " Foreground="#94A3B8" FontSize="13"/>
                            <TextBlock x:Name="TxtStatAttente" Text="0" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#F87171" Margin="0,0,8,0"/>
                            <TextBlock Text="Désactivés : " Foreground="#94A3B8" FontSize="13"/>
                            <TextBlock x:Name="TxtStatDesactives" Text="0" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox x:Name="TxtSearch" Width="220" TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center"/>
                <ComboBox x:Name="ComboFiltre" Width="150" Margin="12,0,0,0" SelectedIndex="0" SelectionChanged="ComboFiltre_SelectionChanged">
                    <ComboBoxItem Content="Tous"/>
                    <ComboBoxItem Content="Actifs"/>
                    <ComboBoxItem Content="En attente"/>
                    <ComboBoxItem Content="Désactivés"/>
                </ComboBox>
                <Button Content="＋ Nouveau compte" Click="BtnShowAdd_Click" Margin="12,0,0,0" Background="#38BDF8" Foreground="#0B1120"/>
            </StackPanel>

                        <DataGrid x:Name="GridUsers" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                      RowHeight="46" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOM" Binding="{Binding Nom}" Width="*"/>
                    <DataGridTextColumn Header="IDENTIFIANT" Binding="{Binding Username}" Width="*"/>
                    <DataGridTextColumn Header="RÔLE" Binding="{Binding Role}" Width="80"/>
                    <DataGridTemplateColumn Header="STATUT" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="6,2" CornerRadius="4" HorizontalAlignment="Left" Background="{Binding StatutColor}">
                                    <TextBlock Text="{Binding StatutAffiche}" FontSize="10" FontWeight="Bold" Foreground="#0B1120"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="DERNIÈRE CONNEXION" Binding="{Binding DerniereConnexionAffiche}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="ACTIONS" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="⭘" Click="BtnToggleStatut_Click" Background="#059669" Width="34" Height="28" Margin="1" Padding="0"
                                            ToolTip="Activer / remettre en attente le compte"/>
                                    <Button Content="🔑" Click="BtnResetPassword_Click" Background="#F59E0B" Width="34" Height="28" Margin="1" Padding="0"
                                            ToolTip="Réinitialiser le mot de passe"/>
                                    <Button Content="✎" Click="BtnEdit_Click" Background="#38BDF8" Foreground="#0B1120" Width="34" Height="28" Margin="1" Padding="0"
                                            ToolTip="Modifier"/>
                                    <Button Content="🗑" Click="BtnDelete_Click" Background="#EF4444" Width="34" Height="28" Margin="1" Padding="0"
                                            ToolTip="Supprimer"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- COLONNE DROITE : FORMULAIRE (création / modification) -->
        <Border x:Name="BorderForm" Grid.Column="1" Background="#151C2C" CornerRadius="15" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtFormTitle" Text="Nouveau compte" FontSize="18" FontWeight="Bold" Margin="0,0,0,18" Foreground="#38BDF8"/>

                    <TextBlock Text="Nom complet"/>
                    <TextBox x:Name="InpNom" Margin="0,5,0,12"/>

                    <TextBlock Text="Identifiant (username)"/>
                    <TextBox x:Name="InpUsername" Margin="0,5,0,12"/>

                    <TextBlock x:Name="TxtLabelPassword" Text="Mot de passe"/>
                    <PasswordBox x:Name="InpPassword" Margin="0,5,0,12"/>

                    <TextBlock Text="Rôle"/>
                    <ComboBox x:Name="InpRole" Margin="0,5,0,12" SelectedIndex="1">
                        <ComboBoxItem Content="Admin"/>
                        <ComboBoxItem Content="Agent"/>
                    </ComboBox>

                    <TextBlock Text="Statut du compte"/>
                    <ComboBox x:Name="InpStatut" Margin="0,5,0,12" SelectedIndex="0">
                        <ComboBoxItem Content="Actif"/>
                        <ComboBoxItem Content="En attente"/>
                        <ComboBoxItem Content="Désactivé"/>
                    </ComboBox>

                    <TextBlock x:Name="TxtHint" Text="Le mot de passe est obligatoire lors de la création d'un compte."
                               Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <UniformGrid Columns="2" Height="42" Margin="0,18,0,0">
                        <Button Content="Annuler" Click="BtnCancel_Click" Background="#475569" Margin="0,0,5,0"/>
                        <Button Content="Enregistrer" Click="BtnSave_Click" Background="#38BDF8" Foreground="#0B1120" Margin="5,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>