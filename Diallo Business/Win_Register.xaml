<Window x:Class="Diallo_Business.Win_Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Créer un compte - Diallo Business" Height="620" Width="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Border Background="#0B1120" CornerRadius="20" BorderBrush="#1E293B" BorderThickness="1" Margin="20">
        <Grid>
            <Grid Height="40" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" Height="30"
                        Margin="0,0,10,0" Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                        FontSize="14" Click="BtnAnnuler_Click" ToolTip="Fermer"/>
            </Grid>

            <StackPanel Margin="40,20,40,25" VerticalAlignment="Center">
                <TextBlock Text="CRÉER UN COMPTE" Foreground="#38BDF8" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Le compte sera créé avec le rôle « Agent » et restera"
                           Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="inactif jusqu'à son activation par un administrateur."
                           Foreground="#F59E0B" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>

                <TextBlock Text="NOM COMPLET" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="0,22,0,0"/>
                <TextBox x:Name="InpNom" Margin="0,6,0,12"/>

                <TextBlock Text="IDENTIFIANT (SANS ESPACE, MIN. 4 CARACTÈRES)" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                <TextBox x:Name="InpUsername" Margin="0,6,0,12"/>

                <TextBlock Text="MOT DE PASSE (MIN. 6 CARACTÈRES)" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                <PasswordBox x:Name="InpPassword" Margin="0,6,0,12"/>

                <TextBlock Text="CONFIRMER LE MOT DE PASSE" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                <PasswordBox x:Name="InpConfirm" Margin="0,6,0,8" KeyDown="InpConfirm_KeyDown"/>

                <TextBlock x:Name="TxtMessage" Text="" Foreground="#F87171" FontSize="12" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,4,0,8"/>

                <UniformGrid Columns="2" Height="42" Margin="0,8,0,0">
                    <Button Content="Annuler" Click="BtnAnnuler_Click" Background="#475569" Margin="0,0,5,0"/>
                    <Button Content="Créer le compte" Click="BtnCreer_Click" Background="#38BDF8" Foreground="#0B1120" Margin="5,0,0,0"/>
                </UniformGrid>
            </StackPanel>
        </Grid>
    </Border>
</Window>