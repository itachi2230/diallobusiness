<Window x:Class="Diallo_Business.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Diallo_Business"
        Title="Diallo Business Center" Height="750" Width="1200"
        WindowStyle="None" AllowsTransparency="True" 
        Background="Transparent" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="4,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0B1120" CornerRadius="20" BorderBrush="#1E293B" BorderThickness="1" Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0F172A" CornerRadius="20,0,0,20">
                <Grid>
                    

                    <StackPanel Margin="0,40,0,0">
                        <StackPanel x:Name="LogoArea" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40">
                            <Border Width="50" Height="50" Background="#38BDF8" CornerRadius="12">
                                <TextBlock Text="D" Foreground="White" FontWeight="Bold" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="LogoText" Text="DIALLO" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnToggle" Content="≡" FontSize="26" Foreground="White" 
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,10,10,0" Width="40" Height="40"
                    Click="BtnToggle_Click" Panel.ZIndex="10"/>
                        <Button Content="🏠   Dashboard" Style="{StaticResource SidebarButton}" x:Name="BtnDashboard" Tag="Dashboard" Click="NavClick"/>
                        <Button Content="📦   Gestion Stock" Style="{StaticResource SidebarButton}" x:Name="BtnStock" Tag="Gestion Stock" Click="NavClick"/>
                        <Button Content="🧾   Facturation" Style="{StaticResource SidebarButton}" x:Name="BtnFactures" Tag="Facturation" Click="NavClick"/>
                        <Button Content="📊   Bilans Financiers" Style="{StaticResource SidebarButton}" x:Name="BtnBilans" Tag="Bilans Financiers" Click="NavClick"/>
                        <Button Content="👥   Utilisateurs" Style="{StaticResource SidebarButton}" x:Name="BtnUtilisateurs" Tag="Utilisateurs" Click="NavClick"/>
                        <Button Content="⚙️   Paramètres" Style="{StaticResource SidebarButton}" x:Name="BtnParametres" Tag="Paramètres" Click="NavClick"/>
                    </StackPanel>

                    <Border x:Name="UserCard" VerticalAlignment="Bottom" Background="#1E293B" CornerRadius="15" Margin="10,20" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="40" Height="40" Fill="#38BDF8"/>
                            <StackPanel x:Name="UserInfo" Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock x:Name="TxtUserName" Text="Invité" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                <TextBlock x:Name="TxtUserRole" Text="Non connecté" Foreground="#10B981" FontSize="10"/>
                            </StackPanel>
                            <Button x:Name="BtnMonCompte" Grid.Column="2" Content="👤" Foreground="#38BDF8"
                                    Background="Transparent" BorderThickness="0" FontSize="14"
                                    Click="BtnMonCompte_Click" VerticalAlignment="Center" Cursor="Hand"
                                    ToolTip="Mon compte (nom, identifiant, mot de passe)"/>
                            <Button x:Name="BtnLogout" Grid.Column="3" Content="⏻" Foreground="#F87171"
                                    Background="Transparent" BorderThickness="0" FontSize="16"
                                    Click="BtnLogout_Click" VerticalAlignment="Center" Cursor="Hand"
                                    ToolTip="Se déconnecter"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0">
                        <Button x:Name="BtnMinimize" Content="−" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="20" Width="40" Click="BtnMinimize_Click"/>
                        <Button x:Name="BtnMaximize" Content="▢" Foreground="White" 
        Background="Transparent" BorderThickness="0" 
        FontSize="16" Width="40" Click="BtnMaximize_Click"/>
                        <Button x:Name="BtnClose" Content="✕" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="18" Width="40" Click="BtnClose_Click"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="50"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtPageTitle" Text="Dashboard" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,0,-0.6,15"/>

                    <ContentControl x:Name="MainContainer"  Grid.Row="1"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>